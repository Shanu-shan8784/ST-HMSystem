# Node Environment
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random 64-char strings)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here
JWT_SECRET=your_fallback_jwt_secret_key_here

# Client CORS Configuration
CLIENT_URL=http://localhost:5173

